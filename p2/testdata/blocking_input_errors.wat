(component
  (import "wasi:io/error@0.2.0" (instance $errors
    (export "error" (type (sub resource)))))
  (alias export $errors "error" (type $error))
  (type $streams-type (instance
    (export "input-stream" (type $input (sub resource)))
    (alias outer 1 $error (type $error))
    (export "error" (type $bound-error (eq $error)))
    (type $stream-error (variant (case "last-operation-failed" (own $bound-error)) (case "closed")))
    (export "stream-error" (type $bound-stream-error (eq $stream-error)))
    (type $bytes (list u8))
    (export "[method]input-stream.blocking-read" (func (param "self" (borrow $input)) (param "len" u64) (result (result $bytes (error $bound-stream-error)))))
    (export "[method]input-stream.blocking-skip" (func (param "self" (borrow $input)) (param "len" u64) (result (result u64 (error $bound-stream-error)))))
  ))
  (import "wasi:io/streams@0.2.0" (instance $streams (type $streams-type)))
  (alias export $streams "input-stream" (type $input))
  (type $stdin-type (instance
    (alias outer 1 $input (type $input))
    (export "input-stream" (type $bound-input (eq $input)))
    (export "get-stdin" (func (result (own $bound-input))))))
  (import "wasi:cli/stdin@0.2.0" (instance $stdin (type $stdin-type)))
  (core module $memory
    (memory (export "memory") 1)
    ;; The guest exports only a status and every test reads one byte, so
    ;; return data can reuse this scratch location between calls.
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (i32.const 64)))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "memory" (core memory $memory))
  (alias core export $memory "realloc" (core func $realloc))
  (alias export $stdin "get-stdin" (func $get))
  (alias export $streams "[method]input-stream.blocking-read" (func $read))
  (alias export $streams "[method]input-stream.blocking-skip" (func $skip))
  (core func $get (canon lower (func $get)))
  (core func $read (canon lower (func $read) (memory $memory) (realloc $realloc)))
  (core func $skip (canon lower (func $skip) (memory $memory)))
  (core module $guest
    (import "host" "memory" (memory 1))
    (import "host" "get" (func $get (result i32)))
    (import "host" "read" (func $read (param i32 i64 i32)))
    (import "host" "skip" (func $skip (param i32 i64 i32)))
    (global $stream (mut i32) (i32.const 0))
    (func $start (global.set $stream (call $get)))
    (start $start)
    ;; 0=success, 1=closed, 2=last-operation-failed.
    (func $status (param i32) (result i32)
      (if (result i32) (i32.eqz (i32.load (i32.const 0)))
        (then (i32.const 0))
        (else (if (result i32) (i32.eq (i32.load (local.get 0)) (i32.const 1))
          (then (i32.const 1)) (else (i32.const 2))))))
    (func (export "read") (param i64) (result i32)
      (call $read (global.get $stream) (local.get 0) (i32.const 0))
      (call $status (i32.const 4)))
    (func (export "skip") (param i64) (result i32)
      (call $skip (global.get $stream) (local.get 0) (i32.const 0))
      (call $status (i32.const 8)))
  )
  (core instance $guest (instantiate $guest
    (with "host" (instance (export "memory" (memory $memory)) (export "get" (func $get)) (export "read" (func $read)) (export "skip" (func $skip))))))
  (func (export "read") (param "len" u64) (result u32) (canon lift (core func $guest "read")))
  (func (export "skip") (param "len" u64) (result u32) (canon lift (core func $guest "skip")))
)
