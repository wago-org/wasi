(component
  (import "wasi:io/error@0.2.0" (instance $errors
    (export "error" (type (sub resource)))))
  (alias export $errors "error" (type $error))
  (type $streams-type (instance
    (export "output-stream" (type $output (sub resource)))
    (alias outer 1 $error (type $error))
    (export "error" (type $bound-error (eq $error)))
    (type $stream-error (variant (case "last-operation-failed" (own $bound-error)) (case "closed")))
    (export "stream-error" (type $bound-stream-error (eq $stream-error)))
    (export "[method]output-stream.check-write" (func (param "self" (borrow $output)) (result (result u64 (error $bound-stream-error)))))
    (export "[method]output-stream.write-zeroes" (func (param "self" (borrow $output)) (param "len" u64) (result (result (error $bound-stream-error)))))
  ))
  (import "wasi:io/streams@0.2.0" (instance $streams (type $streams-type)))
  (alias export $streams "output-stream" (type $output))
  (type $stdout-type (instance
    (alias outer 1 $output (type $output))
    (export "output-stream" (type $bound-output (eq $output)))
    (export "get-stdout" (func (result (own $bound-output))))))
  (import "wasi:cli/stdout@0.2.0" (instance $stdout (type $stdout-type)))
  (core module $memory (memory (export "memory") 1))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "memory" (core memory $memory))
  (alias export $stdout "get-stdout" (func $get))
  (alias export $streams "[method]output-stream.check-write" (func $check))
  (alias export $streams "[method]output-stream.write-zeroes" (func $zeroes))
  (core func $get (canon lower (func $get)))
  (core func $check (canon lower (func $check) (memory $memory)))
  (core func $zeroes (canon lower (func $zeroes) (memory $memory)))
  (core module $guest
    (import "host" "get" (func $get (result i32)))
    (import "host" "check" (func $check (param i32 i32)))
    (import "host" "zeroes" (func $zeroes (param i32 i64 i32)))
    (global $stream (mut i32) (i32.const 0))
    (func $start (global.set $stream (call $get)))
    (start $start)
    (func (export "grant") (call $check (global.get $stream) (i32.const 0)))
    (func (export "zeroes") (param i64) (call $zeroes (global.get $stream) (local.get 0) (i32.const 0)))
  )
  (core instance $guest (instantiate $guest
    (with "host" (instance (export "get" (func $get)) (export "check" (func $check)) (export "zeroes" (func $zeroes))))))
  (func (export "grant") (canon lift (core func $guest "grant")))
  (func (export "zeroes") (param "len" u64) (canon lift (core func $guest "zeroes")))
)
