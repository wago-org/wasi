(component
  (import "wasi:io/error@0.2.0" (instance $errors
    (export "error" (type (sub resource)))))
  (alias export $errors "error" (type $error))
  (import "wasi:io/poll@0.2.0" (instance $poll
    (export "pollable" (type $pollable (sub resource)))
    (export "[method]pollable.ready" (func (param "self" (borrow $pollable)) (result bool)))))
  (alias export $poll "pollable" (type $pollable))
  (type $streams-type (instance
    (export "output-stream" (type $output (sub resource)))
    (alias outer 1 $error (type $error))
    (export "error" (type $bound-error (eq $error)))
    (alias outer 1 $pollable (type $pollable))
    (export "pollable" (type $bound-pollable (eq $pollable)))
    (type $stream-error (variant (case "last-operation-failed" (own $bound-error)) (case "closed")))
    (export "stream-error" (type $bound-stream-error (eq $stream-error)))
    (export "[method]output-stream.check-write"
      (func (param "self" (borrow $output)) (result (result u64 (error $bound-stream-error)))))
    (export "[method]output-stream.subscribe"
      (func (param "self" (borrow $output)) (result (own $bound-pollable))))))
  (import "wasi:io/streams@0.2.0" (instance $streams (type $streams-type)))
  (alias export $streams "output-stream" (type $output))
  (import "wasi:cli/stdout@0.2.0" (instance $stdout
    (alias outer 1 $output (type $output))
    (export "output-stream" (type $bound-output (eq $output)))
    (export "get-stdout" (func (result (own $bound-output))))))
  (alias export $stdout "get-stdout" (func $get))
  (alias export $streams "[method]output-stream.subscribe" (func $subscribe))
  (alias export $poll "[method]pollable.ready" (func $ready))
  (alias export $streams "[method]output-stream.check-write" (func $check))
  (core module $memory (memory (export "memory") 1))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "memory" (core memory $memory))
  (core func $get (canon lower (func $get)))
  (core func $subscribe (canon lower (func $subscribe)))
  (core func $ready (canon lower (func $ready)))
  (core func $check (canon lower (func $check) (memory $memory)))
  (core module $guest
    (import "host" "memory" (memory 1))
    (import "host" "get" (func $get (result i32)))
    (import "host" "subscribe" (func $subscribe (param i32) (result i32)))
    (import "host" "ready" (func $ready (param i32) (result i32)))
    (import "host" "check" (func $check (param i32 i32)))
    (func (export "run") (result i32) (local $stream i32) (local $pollable i32)
      (local.set $stream (call $get))
      (local.set $pollable (call $subscribe (local.get $stream)))
      (if (i32.eqz (call $ready (local.get $pollable))) (then unreachable))
      (call $check (local.get $stream) (i32.const 0))
      (i32.or (i32.load (i32.const 0)) (i32.shl (i32.load (i32.const 8)) (i32.const 8))))
    (func (export "permit-value") (result i64) (i64.load (i32.const 8))))
  (core instance $guest (instantiate $guest
    (with "host" (instance (export "memory" (memory $memory)) (export "get" (func $get))
      (export "subscribe" (func $subscribe)) (export "ready" (func $ready))
      (export "check" (func $check))))))
  (func (export "run") (result u32) (canon lift (core func $guest "run")))
  (func (export "permit-value") (result u64) (canon lift (core func $guest "permit-value")))
)
