{
  "$schema": "https://wago.sh/v1/schema.json",
  "package": {
    "module": "github.com/wago-org/wasi",
    "version": "0.1.1",
    "name": "WASI",
    "description": "WASI Preview 1 host functions with bounded filesystems, stdio, argv, environment, clocks, random, polling, and process exit.",
    "stability": "stable",
    "license": "Apache-2.0",
    "homepage": "https://github.com/wago-org/wasi",
    "repository": "https://github.com/wago-org/wasi",
    "category": "wasi",
    "tags": ["wasi", "wasi-preview1", "syscall", "filesystem", "stdio"],
    "authors": [{ "name": "The Wago authors", "github": "wago-org" }],
    "engines": {
      "wago": ">=0.1.0",
      "go": ">=1.22"
    },
    "platforms": ["darwin/amd64", "darwin/arm64", "linux/amd64"],
    "subpackages": [
      {
        "module": "github.com/wago-org/wasi/p1",
        "name": "WASI Preview 1",
        "description": "The standard wasi_snapshot_preview1 command ABI for core WebAssembly modules.",
        "stability": "stable",
        "tags": ["wasi", "wasi-preview1", "syscall"],
        "platforms": ["darwin/amd64", "darwin/arm64", "linux/amd64"]
      },
      {
        "module": "github.com/wago-org/wasi/unstable",
        "name": "WASI unstable",
        "description": "The deprecated pre-Preview 1 wasi_unstable command ABI for older core WebAssembly modules.",
        "stability": "deprecated",
        "tags": ["wasi", "wasi-unstable", "snapshot0"],
        "platforms": ["darwin/amd64", "darwin/arm64", "linux/amd64"]
      }
    ]
  }
}
