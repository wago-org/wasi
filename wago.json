{
  "$schema": "https://wago.sh/v1/schema.json",
  "package": {
    "module": "github.com/wago-org/wasi",
    "version": "0.2.1",
    "name": "WASI",
    "description": "Complete WASI support: Preview 1, Preview 2, and unstable compatibility.",
    "stability": "stable",
    "license": "Apache-2.0",
    "homepage": "https://github.com/wago-org/wasi",
    "repository": "https://github.com/wago-org/wasi",
    "category": "wasi",
    "tags": ["wasi", "wasi-preview1", "wasi-preview2", "component-model", "filesystem", "stdio"],
    "authors": [{ "name": "The Wago authors", "github": "wago-org" }],
    "engines": {
      "wago": ">=0.1.0",
      "go": ">=1.22"
    },
    "platforms": ["darwin/arm64", "linux/amd64"],
    "subpackages": [
      {
        "module": "github.com/wago-org/wasi/p1",
        "name": "WASI Preview 1",
        "description": "Preview 1 for core WebAssembly modules.",
        "stability": "stable",
        "tags": ["wasi", "wasi-preview1", "syscall"],
        "platforms": ["darwin/amd64", "darwin/arm64", "linux/amd64"]
      },
      {
        "module": "github.com/wago-org/wasi/p2",
        "name": "WASI Preview 2",
        "description": "Preview 2 for WebAssembly components.",
        "stability": "experimental",
        "tags": ["wasi", "wasi-preview2", "component-model", "filesystem", "sockets", "stdio", "clocks", "random"],
        "platforms": ["darwin/arm64", "linux/amd64"]
      },
      {
        "module": "github.com/wago-org/wasi/unstable",
        "name": "WASI unstable",
        "description": "Legacy wasi_unstable compatibility.",
        "stability": "stable",
        "tags": ["wasi", "wasi-unstable", "snapshot0"],
        "platforms": ["darwin/amd64", "darwin/arm64", "linux/amd64"]
      }
    ]
  },
  "plugins": {
    "github.com/wago-org/component-model": "^0.1.0"
  }
}
