                  "read": {
                    "type": "boolean"
                  },
                  "write": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "guest",
                  "host"
                ],
                "type": "object"
              },
              "maxItems": 64,
              "type": "array"
            },
            "preopens": {
              "additionalProperties": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "maxProperties": 64,
              "propertyNames": {
                "maxLength": 4096,
                "pattern": "^/(?:[^/\\u0000]+(?:/[^/\\u0000]+)*)?$",
                "type": "string"
              },
              "type": "object"
            },
            "stderr": {
              "enum": [
                "inherit",
                "discard"
              ],
              "type": "string"
            },
            "stdin": {
              "enum": [
                "inherit",
                "eof"
              ],
              "type": "string"
            },
            "stdout": {
              "enum": [
                "inherit",
                "discard"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "provides": [
          {
            "id": "github.com/wago-org/wasi/p2/command",
            "major": 1
          }
        ],
        "consumes": [
          {
            "id": "github.com/wago-org/component-model/runtime",
            "major": 1,
            "mode": "required"
          }
        ]
      },
      "definitionDigest": "sha256:75addc6447f8c070363d611bb6e5c69420a94acbba925f93648680e1f11837b9"
    },
