{
  "$schema": "https://wago.sh/v1/providers.schema.json",
  "providers": [
    {
      "importPath": "github.com/wago-org/wasi/register",
      "definition": {
        "id": "github.com/wago-org/wasi",
        "name": "WASI",
        "version": "0.1.0",
        "description": "WASI Preview 1 host functions with bounded filesystems, stdio, argv, environment, clocks, random, polling, and process exit.",
        "stability": "stable",
        "compatibility": {
          "engines": {
            "go": "\u003e=1.22",
            "wago": "\u003e=0.1.0"
          },
          "platforms": [
            "linux/amd64"
          ]
        },
        "provenance": {
          "homepage": "https://github.com/wago-org/wasi",
          "repository": "https://github.com/wago-org/wasi",
          "license": "Apache-2.0",
          "authors": [
            "The Wago authors"
          ]
        },
        "authorities": [
          {
            "name": "host.arguments.read",
            "mode": "required",
            "reason": "expose this runtime's immutable guest argv through Preview 1",
            "scope": {}
          },
          {
            "name": "host.caller.identify",
            "mode": "required",
            "reason": "isolate descriptor tables by the opaque identity of the active guest",
            "scope": {}
          },
          {
            "name": "host.import.define",
            "mode": "required",
            "reason": "define the selected WASI snapshot's host functions",
            "scope": {
              "modules": [
                "wasi_snapshot_preview1"
              ]
            }
          },
          {
            "name": "instance.close.observe",
            "mode": "required",
            "reason": "close the departed guest's files without receiving instance control",
            "scope": {}
          }
        ],
        "configSchema": {
          "additionalProperties": false,
          "properties": {
            "env": {
              "items": {
                "maxLength": 32768,
                "minLength": 2,
                "pattern": "^[^=\\u0000]+=[^\\u0000]*$",
                "type": "string"
              },
              "maxItems": 4096,
              "type": "array"
            },
            "maxOpenFiles": {
              "maximum": 65536,
              "minimum": 3,
              "type": "integer"
            },
            "maxPollDurationMillis": {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            "preopens": {
              "additionalProperties": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "maxProperties": 64,
              "propertyNames": {
                "maxLength": 4096,
                "pattern": "^/(?:[^/\\u0000]+(?:/[^/\\u0000]+)*)?$",
                "type": "string"
              },
              "type": "object"
            },
            "stderr": {
              "enum": [
                "inherit",
                "discard"
              ],
              "type": "string"
            },
            "stdin": {
              "enum": [
                "inherit",
                "eof"
              ],
              "type": "string"
            },
            "stdout": {
              "enum": [
                "inherit",
                "discard"
              ],
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "definitionDigest": "sha256:5a1f61d7cb2025663c57e2f86c16231949d8d0c7a3098abad98d4623b3ac6df8"
    },
