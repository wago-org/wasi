{
  "$schema": "https://wago.sh/v1/providers.schema.json",
  "providers": [
    {
      "importPath": "github.com/wago-org/wasi/register",
      "definition": {
        "id": "github.com/wago-org/wasi",
        "name": "WASI",
        "version": "0.2.1",
        "description": "Complete WASI support: Preview 1, Preview 2, and unstable compatibility.",
        "stability": "stable",
        "compatibility": {
          "engines": {
            "go": "\u003e=1.22",
            "wago": "\u003e=0.1.0"
          },
          "platforms": [
            "darwin/arm64",
            "linux/amd64"
          ]
        },
        "provenance": {
          "homepage": "https://github.com/wago-org/wasi",
          "repository": "https://github.com/wago-org/wasi",
          "license": "Apache-2.0",
          "authors": [
            "The Wago authors"
          ]
        },
        "requires": [
          {
            "id": "github.com/wago-org/wasi/p1",
            "version": "^0.2.1"
          },
          {
            "id": "github.com/wago-org/wasi/p2",
            "version": "^0.2.1"
          },
          {
            "id": "github.com/wago-org/wasi/unstable",
            "version": "^0.2.1"
          }
        ]
      },
      "definitionDigest": "sha256:ee223ad26c7b0c8894c5a38848a7291975bcb39bc9625deebfa4ebf71bcc071f"
    },
    {
      "importPath": "github.com/wago-org/wasi/register",
      "definition": {
        "id": "github.com/wago-org/wasi/p1",
        "name": "WASI Preview 1",
        "version": "0.2.1",
        "description": "Preview 1 for core WebAssembly modules.",
        "stability": "stable",
        "compatibility": {
          "engines": {
            "go": "\u003e=1.22",
            "wago": "\u003e=0.1.0"
          },
          "platforms": [
            "darwin/amd64",
            "darwin/arm64",
            "linux/amd64"
          ]
        },
        "provenance": {
          "homepage": "https://github.com/wago-org/wasi",
          "repository": "https://github.com/wago-org/wasi",
          "license": "Apache-2.0",
          "authors": [
            "The Wago authors"
          ]
        },
        "authorities": [
          {
            "name": "host.arguments.read",
            "mode": "required",
            "reason": "expose this runtime's immutable guest argv through Preview 1",
            "scope": {}
          },
          {
            "name": "host.caller.identify",
            "mode": "required",
            "reason": "isolate descriptor tables by the opaque identity of the active guest",
            "scope": {}
          },
          {
            "name": "host.import.define",
            "mode": "required",
            "reason": "define the selected WASI snapshot's host functions",
            "scope": {
              "modules": [
                "wasi_snapshot_preview1"
              ]
            }
          },
          {
            "name": "instance.close.observe",
            "mode": "required",
            "reason": "close the departed guest's files without receiving instance control",
            "scope": {}
          }
        ],
        "configSchema": {
          "additionalProperties": false,
          "properties": {
            "env": {
              "items": {
                "maxLength": 32768,
                "minLength": 2,
                "pattern": "^[^=\\u0000]+=[^\\u0000]*$",
                "type": "string"
              },
              "maxItems": 4096,
              "type": "array"
            },
            "maxOpenFiles": {
              "maximum": 65536,
              "minimum": 3,
              "type": "integer"
            },
            "maxPollDurationMillis": {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            "preopens": {
              "additionalProperties": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "maxProperties": 64,
              "propertyNames": {
                "maxLength": 4096,
                "pattern": "^/(?:[^/\\u0000]+(?:/[^/\\u0000]+)*)?$",
                "type": "string"
              },
              "type": "object"
            },
            "stderr": {
              "enum": [
                "inherit",
                "discard"
              ],
              "type": "string"
            },
            "stdin": {
              "enum": [
                "inherit",
                "eof"
              ],
              "type": "string"
            },
            "stdout": {
              "enum": [
                "inherit",
                "discard"
              ],
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "definitionDigest": "sha256:d81cb88f445427c936f3b4a18636e5fe4b45edb57c32c8288f90186141ccbf66"
    },
    {
      "importPath": "github.com/wago-org/wasi/register",
      "definition": {
        "id": "github.com/wago-org/wasi/p2",
        "name": "WASI Preview 2",
