              "type": "array"
            },
            "preopens": {
              "additionalProperties": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "maxProperties": 64,
              "propertyNames": {
                "maxLength": 4096,
                "pattern": "^/(?:[^/\\u0000]+(?:/[^/\\u0000]+)*)?$",
                "type": "string"
              },
              "type": "object"
            },
            "stderr": {
              "enum": [
                "inherit",
                "discard"
              ],
              "type": "string"
            },
            "stdin": {
              "enum": [
                "inherit",
                "eof"
              ],
              "type": "string"
            },
            "stdout": {
              "enum": [
                "inherit",
                "discard"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "provides": [
          {
            "id": "github.com/wago-org/wasi/p2/command",
            "major": 1
          }
        ],
        "consumes": [
          {
            "id": "github.com/wago-org/component-model/runtime",
            "major": 1,
            "mode": "required"
          }
        ]
      },
      "definitionDigest": "sha256:bd029c1ce83c49c1f0b82df570afe762297a98ac6056c58105af03295023202a"
    },
